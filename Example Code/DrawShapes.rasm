; Draws a rectangle and square in green

; Rectangle
label $start
    db R0 @10
    db R1 @10

label $rect_top
    scrnwrt R0 R1 @20 @255 @20

    db R4 @29
    arithmetic sub R4 R0
    jz $rect_sides

    arithmetic inc R0
    jmp $rect_top


label $rect_sides
    db R0 @10
    db R1 @11

label $rect_sidesloop
    scrnwrt R0 R1 @20 @255 @20

    db R0 @29
    scrnwrt R0 R1 @20 @255 @20

    db R4 @38
    arithmetic sub R4 R1
    jz $rect_bottom

    arithmetic inc R1
    db R0 @10
    jmp $rect_sidesloop


label $rect_bottom
    db R0 @10
    db R1 @39

label $rect_bottomloop
    scrnwrt R0 R1 @20 @255 @20

    db R4 @29
    arithmetic sub R4 R0
    jz $square_start

    arithmetic inc R0
    jmp $rect_bottomloop


; Square
label $square_start
    db R0 @50
    db R1 @50

label $square_top
    scrnwrt R0 R1 @20 @255 @20

    db R4 @79
    arithmetic sub R4 R0
    jz $square_sides

    arithmetic inc R0
    jmp $square_top


label $square_sides
    db R0 @50
    db R1 @51

label $square_sidesloop
    scrnwrt R0 R1 @20 @255 @20

    db R0 @79
    scrnwrt R0 R1 @20 @255 @20

    db R4 @78
    arithmetic sub R4 R1
    jz $square_bottom

    arithmetic inc R1
    db R0 @50
    jmp $square_sidesloop


label $square_bottom
    db R0 @50
    db R1 @79

label $square_bottomloop
    scrnwrt R0 R1 @20 @255 @20

    db R4 @79
    arithmetic sub R4 R0
    jz $end

    arithmetic inc R0
    jmp $square_bottomloop


label $end
    end